// Shared receiver-mesh topology and validity for flux resolve and rasterization.
layout(set=0,binding=0,std430) readonly buffer Configuration {
    vec4 fft; vec4 region; vec4 extent; ivec4 flags;
    vec4 water; vec4 tile; vec4 sun; vec4 medium; vec4 foam;
} cfg;
struct LightHit { vec4 origin; vec4 hit; vec4 transmission; };
layout(set=0,binding=1,std430) readonly buffer Hits { LightHit hits[]; };
layout(set=0,binding=2) uniform sampler2D swe_map;

ivec3 caustic_indices(ivec2 cell,int triangle) {
    int a=cell.y*(cfg.flags.w+1)+cell.x;
    return triangle==0?ivec3(a,a+cfg.flags.w+1,a+1):ivec3(a+1,a+cfg.flags.w+1,a+cfg.flags.w+2);
}
bool caustic_triangle(ivec3 indices,out vec3 irradiance,out float area) {
    LightHit x=hits[indices.x],y=hits[indices.y],z=hits[indices.z];
    area=length(cross(y.hit.xyz-x.hit.xyz,z.hit.xyz-x.hit.xyz));
    irradiance=vec3(0.0);
    if(x.origin.w*y.origin.w*z.origin.w<0.5) return false;
    if(cfg.flags.y!=0) {
        vec3 center=(x.hit.xyz+y.hit.xyz+z.hit.xyz)/3.0;
        vec2 d=center.xz-cfg.region.xy;
        vec2 uv=vec2(cfg.region.z*d.x-cfg.region.w*d.y,cfg.region.w*d.x+cfg.region.z*d.y)/cfg.extent.xy+0.5;
        vec4 bed=textureLod(swe_map,uv,0.0);
        if(bed.w<0.5||abs(bed.z+cfg.water.x-center.y)>max(0.1,max(cfg.extent.x,cfg.extent.y)/float(cfg.flags.z)*1.5)) return false;
    }
    float projected=abs(dot(cross(y.origin.xyz-x.origin.xyz,z.origin.xyz-x.origin.xyz),normalize(cfg.sun.xyz)));
    float footprint=max(cfg.tile.z,cfg.tile.w)/p.map.x;
    float gain=projected/max(area,footprint*footprint*0.25);
    irradiance=(x.transmission.xyz+y.transmission.xyz+z.transmission.xyz)*(gain/3.0);
    return true;
}
